{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dotnetcore-s3-utility",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "vars": {
    "R2_ENDPOINT": ""
  },
  "containers": [
    {
      "class_name": "S3UtilityApi",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "API", "class_name": "S3UtilityApi" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["S3UtilityApi"] }
  ],
  "observability": { "enabled": true }
}
